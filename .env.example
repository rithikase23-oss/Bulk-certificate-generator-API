# -------------------------------------------------------------
# AI Studio & Deployment Environment Variables
# -------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# Bulk Certificate Generator Backend Configuration
# -------------------------------------------------------------
# Server port (Render dynamically provides PORT at runtime; default is 8000)
PORT=8000

# Server host (0.0.0.0 binds to all network interfaces for container deployments)
HOST="0.0.0.0"

# Application runtime environment: 'development', 'testing', or 'production'
APP_ENV="development"

# Database Connection URL:
# Local development default: Lightweight SQLite file
DATABASE_URL="sqlite:///./certificates.db"
# Production example for Render Managed PostgreSQL:
# DATABASE_URL="postgresql://cert_user:your_password@dpg-xxxxxx.oregon-postgres.render.com/certificates_db"

# Persistent Storage Directory:
# Local default: ./certificates_storage
# Production on Render: Mount a Render Persistent Disk to /var/data/certificates
STORAGE_DIR="./certificates_storage"

# Maximum number of recipients allowed in a single POST /jobs batch request
MAX_RECIPIENTS_PER_BATCH=500

# Logging severity level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL="INFO"
